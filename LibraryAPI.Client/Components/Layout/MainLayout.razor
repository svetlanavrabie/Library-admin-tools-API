@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <button type="button" class="menu-toggle" aria-label="Toggle navigation" aria-expanded="@_menuOpen" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">L</span>
            <span class="brand-name">Library Admin</span>
        </a>
    </header>

    <aside class="sidebar @(_menuOpen ? "open" : null)">
        <NavMenu OnNavigate="CloseMenu" />
    </aside>

    @if (_menuOpen)
    {
        <div class="backdrop" @onclick="CloseMenu"></div>
    }

    <main class="content">
        @Body
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" role="button" aria-label="Dismiss">&times;</span>
</div>
